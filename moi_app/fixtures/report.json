  "report_script": "def execute(filters=None):\n    columns = [\n        {\"label\": \"Parent\", \"fieldname\": \"parent\", \"fieldtype\": \"Link\", \"options\": \"Media Production\", \"width\": 200},\n        {\"label\": \"Program Name\", \"fieldname\": \"program_name\", \"fieldtype\": \"Data\", \"width\": 200},\n        {\"label\": \"Type\", \"fieldname\": \"type\", \"fieldtype\": \"Data\", \"width\": 150},\n        {\"label\": \"Weight\", \"fieldname\": \"weight\", \"fieldtype\": \"Float\", \"width\": 100},\n        {\"label\": \"Count\", \"fieldname\": \"count\", \"fieldtype\": \"Int\", \"width\": 100},\n        {\"label\": \"Title\", \"fieldname\": \"title\", \"fieldtype\": \"Data\", \"width\": 200},\n        {\"label\": \"Link\", \"fieldname\": \"link\", \"fieldtype\": \"Data\", \"width\": 200},\n        {\"label\": \"Date\", \"fieldname\": \"date\", \"fieldtype\": \"Date\", \"width\": 120}\n    ]\n\n    data = frappe.get_all(\n        \"Media Production Child\",\n        fields=[\"parent\", \"program_name\", \"type\", \"weight\", \"count\", \"title\", \"link\", \"date\"],\n        order_by=\"creation desc\"\n    )\n\n    return columns, data\n",
