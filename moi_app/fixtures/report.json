  "name": "Task KPI Report",
  "prepared_report": 0,
  "query": "SELECT 'Total Tasks' AS kpi, COUNT(name) AS value\r\nFROM `tabTask`\r\n\r\nUNION ALL\r\nSELECT 'Completed Tasks' AS kpi, COUNT(name) AS value\r\nFROM `tabTask`\r\nWHERE status = 'Completed'\r\n\r\nUNION ALL\r\nSELECT 'Open Tasks' AS kpi, COUNT(name) AS value\r\nFROM `tabTask`\r\nWHERE status != 'Completed'\r\n\r\nUNION ALL\r\nSELECT 'Overdue Tasks' AS kpi, COUNT(name) AS value\r\nFROM `tabTask`\r\nWHERE status != 'Completed'\r\n  AND exp_end_date IS NOT NULL\r\n  AND exp_end_date < CURDATE();\r\n",
